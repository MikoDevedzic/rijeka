# Rijeka self-host settings: cp .env.selfhost.example .env.selfhost, then edit. Read by docker-compose.yml
# (variable substitution) and handed to the api and auth containers as their environment.
# Never commit .env.selfhost (the .gitignore keeps only this example).

# ── database (the db service; the api, migrate and auth services derive their URLs from these) ────────
POSTGRES_USER=rijeka
POSTGRES_PASSWORD=change-me-before-first-up
POSTGRES_DB=rijeka

# ── where people reach it ─────────────────────────────────────────────────────────────────────────────
# The web service's public origin (nginx: the app, /auth/v1 and /api). The app signs in against
# <RIJEKA_PUBLIC_URL>/auth/v1 and calls the API at RIJEKA_API_URL (its own published port).
RIJEKA_PUBLIC_URL=http://localhost:8080
RIJEKA_API_URL=http://localhost:8000
RIJEKA_WEB_PORT=8080
RIJEKA_API_PORT=8000

# ── auth (GoTrue) ─────────────────────────────────────────────────────────────────────────────────────
# A long random string; GoTrue requires it even though tokens are signed with the asymmetric key below.
GOTRUE_JWT_SECRET=change-me-32-plus-random-characters
# The ES256 signing key as a JSON list of private JWKs. Generate it with
#   cd backend && python -m stack.keys && cat stack/.local/gotrue_keys.json
# and paste the single line here. The API verifies tokens against the public half GoTrue publishes at
# /auth/v1/.well-known/jwks.json; the private half never leaves the auth container.
GOTRUE_JWT_KEYS=[{"kty":"EC","crv":"P-256","x":"...","y":"...","d":"...","kid":"...","alg":"ES256","use":"sig","key_ops":["sign","verify"]}]
# true: email sign-up confirms itself (no SMTP). false: fill the SMTP lines so confirmation mail goes out.
GOTRUE_MAILER_AUTOCONFIRM=true
GOTRUE_DISABLE_SIGNUP=false
GOTRUE_SMTP_HOST=
GOTRUE_SMTP_PORT=
GOTRUE_SMTP_USER=
GOTRUE_SMTP_PASS=
GOTRUE_SMTP_ADMIN_EMAIL=
# supabase-js sends this as the apikey header; GoTrue alone does not check it (Kong does on Supabase).
SUPABASE_ANON_KEY=selfhost-anon

# ── api switches (docs/ops/environment.md has every variable) ─────────────────────────────────────────
RIJEKA_DEMO_PROVISION=0
RIJEKA_DEMO_MARKET_DATA=0
RIJEKA_SCHEDULER=1
RIJEKA_LOG_LEVEL=INFO
# RIJEKA_CRON_SECRET=
# ANTHROPIC_API_KEY=

# ── on-chain confirmation (optional; all unset = attestations stored off-chain, chain/attestation NullBackend)
# RIJEKA_CHAIN_RPC=
# RIJEKA_CHAIN_REGISTRY=
# RIJEKA_CHAIN_RELAYER_KEY=
# RIJEKA_CHAIN_EXPLORER=
# RIJEKA_CHAIN_KEY_<LEI>=
