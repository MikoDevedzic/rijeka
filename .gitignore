# Rijeka .gitignore. Short on purpose: what is local stays local, everything else is the repository.

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.ruff_cache/

# ── Node / Vite ──────────────────────────────────────────────────────────────
node_modules/
dist/
.vite/

# ── Secrets and local environments (the examples are tracked) ────────────────
.env
.env.*
!.env.example
!.env.selfhost.example
*.bak
*.bak.*

# ── Build output, logs, OS and editor files ──────────────────────────────────
*.log
*.tmp
*.swp
.DS_Store
Thumbs.db
.vscode/
.idea/
.claude/launch.json
chain/out/
chain/cache/
chain/broadcast/

# ── Local only, never on GitHub ──────────────────────────────────────────────
# The landing site (rijeka.app) and the public tools, deployed by hand with the Netlify CLI.
netlify_drop/
# Internal working notes, scratch and marketing drafts. The public documentation is docs/.
_docs/
_scratch/
_marketing/
# Sprint-era notes that may still sit at the repository root on a developer's machine.
/ARCHITECTURE*.md
/HANDOFF_*.md
/SPRINT*_HANDOFF.md
/sprint */
