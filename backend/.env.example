# Copy to .env and fill in values — NEVER COMMIT .env
DATABASE_URL=postgresql://postgres:[password]@db.upuewetohnocfshkhafg.supabase.co:5432/postgres
# (no JWT secret: tokens are verified against Supabase's published ES256 keys)
SUPABASE_URL=https://<project-ref>.supabase.co
FRONTEND_URL=https://app.rijeka.app

# ── On-chain confirmation (backend/chain) ─────────────────────────────
# Local demo: parties' signing keys derived from this seed (dev only).
RIJEKA_CHAIN_DEV_SEED=rijeka-local-dev
# Anchor on a chain (omit all three to sign off-chain only):
# RIJEKA_CHAIN_RPC=http://127.0.0.1:8545
# RIJEKA_CHAIN_REGISTRY=0x...
# RIJEKA_CHAIN_RELAYER_KEY=0x...
# RIJEKA_CHAIN_EXPLORER=https://sepolia.etherscan.io

# ── Telegram channel adapter (backend/chain/telegram.py) ───────────────
# Create a bot with @BotFather, paste its token here; pick any long random
# string as the webhook secret; RIJEKA_PUBLIC_URL is where deep links point.
# Then register the webhook once (see chain/README.md).
# TELEGRAM_BOT_TOKEN=123456:ABC-DEF...
# TELEGRAM_WEBHOOK_SECRET=<random 32+ chars>
# RIJEKA_PUBLIC_URL=https://rijeka.app

# ── NEWS room (api/routes/news.py) ──────────────────────────────────────
# Shared secret for the cron that calls POST /api/news/tick (header X-Rijeka-Cron).
# Unset = the tick cannot be called. See .github/workflows/news-tick.yml.
# RIJEKA_CRON_SECRET=<random 32+ chars>
# Relayer budget (chain/budget.py): anchoring attempts per rolling 24h. All unset = budget off (local, self-hosted);
# firm defaults to 3x the user cap, global to 200 once the user cap is set.
# RIJEKA_CHAIN_DAILY_LIMIT=20
# RIJEKA_CHAIN_FIRM_DAILY_LIMIT=60
# RIJEKA_CHAIN_GLOBAL_DAILY_LIMIT=200
# RIJEKA_CHAIN_MAX_FEE_GWEI=100

# ── Hosted-demo behaviour (docs/ops/environment.md has every variable with its default) ─────
# RIJEKA_SIGNUP_PRESET=LAUNCH         # the modules a new workspace starts on (LAUNCH, DEALER, ...); NONE = nothing chosen
# RIJEKA_DEMO_PROVISION=1            # every sign-in gets a sandbox workspace, and capital is kept for the admin role; 0 on your own desk
# RIJEKA_HELD_MODULES=NONE           # with sandboxes on: hold nothing back (unset = CAPITAL is kept for the admin role)
# RIJEKA_DEMO_TEMPLATE_EMAIL=        # whose market data new visitors get a copy of
# RIJEKA_DEMO_MARKET_DATA=1          # daily rebuild from public sources; 0 to run on your own marks
# RIJEKA_DERIBIT=1                   # digital-asset vols, forwards and daily fixings from Deribit's public marks; 0 stops the requests (the rows are removed only by a process that runs the batches: docs/ops/environment.md)
# RIJEKA_USAGE_SALT=                 # salt for the usage beacon's daily-rotating visitor id
# RIJEKA_LOG_LEVEL=INFO
# CORS_ORIGINS=                      # extra allowed origins, comma-separated

# ── In-process scheduler and the release move (backend/scheduler.py, docs/ops/deploy.md) ───
# RIJEKA_SCHEDULER=auto              # on when RENDER is set; 1 / 0 to force
# RIJEKA_SCHEDULER_MINUTES=30
# RIJEKA_SCHEDULER_MARKS_MINUTES=10
# RIJEKA_SCHEDULER_DAILY_HOURS=2
# RIJEKA_GITHUB_TOKEN=               # fine-grained PAT, Contents read/write on the repo only
# RIJEKA_GITHUB_REPO=MikoDevedzic/rijeka
# RIJEKA_PUBLIC_API_URL=             # default: RENDER_EXTERNAL_URL

# ── Chain extras ───────────────────────────────────────────────────────────────────────────
# RIJEKA_CHAIN_RPC_FALLBACK=         # second node, used after two failed calls
# RIJEKA_CHAIN_DEV_LEI_PREFIX=DEMO   # only LEIs with this prefix are signed from the dev seed
# RIJEKA_CHAIN_KEY_<LEI>=0x...       # a legal entity's own signing key, by LEI

# ── Assistants (all optional; unset = the feature says it is not configured) ───────────────
# ANTHROPIC_API_KEY=
# PROMETHEUS_MODEL=claude-opus-5
# RIJEKA_PROMETHEUS_DAILY_TOKENS=400000
# RIJEKA_BOOK_BRIEF=1
# RIJEKA_BRIEF_MODEL=claude-opus-5-5
# RIJEKA_NEWS_SUMMARIES=1
# RIJEKA_NEWS_MODEL=claude-haiku-5-5
# RIJEKA_SOURCE_URL=https://github.com/MikoDevedzic/rijeka
